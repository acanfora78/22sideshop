[
  {
    "name": "theme_info",
    "theme_name": "22SIDE Underground",
    "theme_version": "1.0.0",
    "theme_author": "22SIDE",
    "theme_documentation_url": "https://github.com/acanfora78/22sideshop",
    "theme_support_url": "https://github.com/acanfora78/22sideshop"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "slogan",
        "label": "Slogan",
        "default": "No rules. Just attitude."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Catalogo",
    "settings": [
      {
        "type": "text",
        "id": "catalog_label",
        "label": "Voce del menu",
        "default": "Catalogo"
      },
      {
        "type": "text",
        "id": "catalog_lines",
        "label": "Linee (handle delle collezioni, in ordine, separate da virgola)",
        "default": "t-shirt, longsleeve, coordinati, pantaloni",
        "info": "Usate dal menu Catalogo, dai filtri del catalogo e da \"Pick your line\". Si vedono solo le collezioni che hanno prodotti."
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok"
      }
    ]
  },
  {
    "name": "Scheda prodotto",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Spedizione gratuita sopra (€)",
        "info": "Vuoto o 0 = non mostrare. Deve coincidere con le tariffe in Impostazioni › Spedizione."
      },
      {
        "type": "text",
        "id": "delivery_text",
        "label": "Tempi di consegna (es. \"Consegna in 2–4 giorni lavorativi\")",
        "info": "Vuoto = non mostrare."
      },
      {
        "type": "number",
        "id": "returns_days",
        "label": "Giorni per il reso",
        "default": 14
      }
    ]
  },
  {
    "name": "Contatti rapidi",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_floating_contact",
        "label": "Mostra i pulsanti WhatsApp e Instagram a destra",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "Numero WhatsApp (con prefisso, es. 393532359486)",
        "default": "393532359486"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "Messaggio precompilato",
        "default": "Ciao 22SIDE!"
      }
    ]
  }
]