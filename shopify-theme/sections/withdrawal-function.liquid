{%- comment -%}
  Digital withdrawal function — art. 54-bis Codice del Consumo (D.Lgs. 209/2025, from 19 June 2026).
  Step 1: the page is reached from the always-visible "Recedi dal contratto qui" link (footer).
  Step 2: the consumer gives name, order identification and the email for the acknowledgement.
  Step 3: "Conferma recesso" sends the declaration (Shopify contact form → shop email).
  The acknowledgement on a durable medium (email with content, date and time) must be sent by the
  shop without undue delay: see docs/legal/02-recesso-e-resi.md (template email) and docs/admin-checklist.md.
  The confirmation screen also shows a summary with date and time that the customer can save or print.
{%- endcomment -%}
<section class="px-gutter pb-24" id="recesso" data-withdrawal>
  <div class="max-w-2xl border border-dirty/20 bg-asphalt p-6 md:p-10">
    <h2 class="font-display text-4xl md:text-5xl">{{ 'withdrawal.title' | t }}</h2>
    <p class="mt-4 text-base leading-relaxed text-dirty/85">{{ 'withdrawal.intro' | t }}</p>

    {%- form 'contact', id: 'withdrawal-form', class: 'mt-8 space-y-6', data-withdrawal-form: '' -%}
      {%- if form.posted_successfully? -%}
        <div class="border-l-4 border-signal bg-obsidian p-5" role="status" tabindex="-1" data-withdrawal-done>
          <p class="font-display text-3xl">{{ 'withdrawal.done_title' | t }}</p>
          <p class="mt-3 text-base leading-relaxed text-dirty/85">{{ 'withdrawal.done_text' | t }}</p>
          <dl class="mt-4 grid gap-1 text-sm text-dirty/85" data-withdrawal-summary></dl>
          <button type="button" class="label mt-5 inline-flex min-h-11 items-center border border-dirty/40 px-4 hover:border-dirty" data-withdrawal-print>{{ 'withdrawal.print' | t }}</button>
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="border-l-4 border-signal p-4 text-sm text-dirty" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <input type="hidden" name="contact[Tipo di richiesta]" value="RECESSO — art. 54-bis Codice del Consumo">
        <input type="hidden" name="contact[Dichiarazione]" value="{{ 'withdrawal.declaration' | t | escape }}">
        <input type="hidden" name="contact[Inviato il]" value="" data-withdrawal-time>

        <div>
          <label for="wd-name" class="label mb-2 block text-dirty">{{ 'withdrawal.name' | t }} *</label>
          <input id="wd-name" type="text" name="contact[Nome e cognome]" required autocomplete="name" class="min-h-12 w-full border border-dirty/30 bg-obsidian px-4 text-base text-dirty focus:border-dirty focus:outline-none">
        </div>
        <div>
          <label for="wd-email" class="label mb-2 block text-dirty">{{ 'withdrawal.email' | t }} *</label>
          <input id="wd-email" type="email" name="contact[email]" required autocomplete="email" aria-describedby="wd-email-help" class="min-h-12 w-full border border-dirty/30 bg-obsidian px-4 text-base text-dirty focus:border-dirty focus:outline-none">
          <p id="wd-email-help" class="mt-2 text-sm text-dirty/70">{{ 'withdrawal.email_help' | t }}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="wd-order" class="label mb-2 block text-dirty">{{ 'withdrawal.order' | t }} *</label>
            <input id="wd-order" type="text" name="contact[Numero ordine]" required placeholder="#1001" class="min-h-12 w-full border border-dirty/30 bg-obsidian px-4 text-base text-dirty placeholder:text-concrete focus:border-dirty focus:outline-none">
          </div>
          <div>
            <label for="wd-date" class="label mb-2 block text-dirty">{{ 'withdrawal.date' | t }}</label>
            <input id="wd-date" type="date" name="contact[Data ordine o consegna]" class="min-h-12 w-full border border-dirty/30 bg-obsidian px-4 text-base text-dirty focus:border-dirty focus:outline-none">
          </div>
        </div>
        <div>
          <label for="wd-items" class="label mb-2 block text-dirty">{{ 'withdrawal.items' | t }}</label>
          <textarea id="wd-items" name="contact[Articoli]" rows="3" aria-describedby="wd-items-help" class="w-full border border-dirty/30 bg-obsidian px-4 py-3 text-base text-dirty focus:border-dirty focus:outline-none"></textarea>
          <p id="wd-items-help" class="mt-2 text-sm text-dirty/70">{{ 'withdrawal.items_help' | t }}</p>
        </div>
        <p class="text-sm leading-relaxed text-dirty/80">{{ 'withdrawal.declaration' | t }}</p>
        <button type="submit" class="label inline-flex min-h-12 items-center bg-blood px-8 text-dirty hover:bg-dirty hover:text-obsidian">{{ 'withdrawal.confirm' | t }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Funzione di recesso",
  "settings": [],
  "presets": [{ "name": "Funzione di recesso" }]
}
{% endschema %}
