{%- liquid
  assign current = product.selected_or_first_available_variant
  assign mf = product.metafields.custom
  assign captions = mf.immagini_didascalie.value
  assign pending = false
  if product.tags contains 'prezzo-da-confermare' or product.tags contains 'taglie-da-confermare'
    assign pending = true
  endif
  assign release = mf.data_uscita.value
  assign upcoming = false
  if release != blank
    assign release_s = release | date: '%s' | plus: 0
    assign now_s = 'now' | date: '%s' | plus: 0
    if release_s > now_s
      assign upcoming = true
      assign pending = true
    endif
  endif
  assign buyable = false
  if pending == false and product.available
    assign buyable = true
  endif
  assign form_id = 'product-form-' | append: section.id
-%}

<script type="application/ld+json">{{ product | structured_data }}</script>

<section class="px-gutter pb-16 pt-28 md:pt-36" data-product data-product-id="{{ product.id }}" data-pending="{{ pending }}">
  <nav class="label text-concrete" aria-label="{{ 'general.breadcrumb.label' | t }}">
    <a href="{{ routes.root_url }}" class="hover:text-dirty">{{ 'general.breadcrumb.home' | t }}</a> /
    <a href="{{ routes.all_products_collection_url }}" class="hover:text-dirty">{{ 'general.breadcrumb.shop' | t }}</a> /
    <span class="text-dirty">{{ product.title }}</span>
  </nav>

  <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-14">
    {%- comment -%} Gallery: stacked on desktop (click to zoom), swipe with dots on mobile. {%- endcomment -%}
    <div class="lg:col-span-7">
      <ul class="no-scrollbar -mx-[var(--gutter)] flex snap-x snap-mandatory gap-3 overflow-x-auto px-[var(--gutter)] lg:mx-0 lg:grid lg:grid-cols-2 lg:overflow-visible lg:px-0" aria-label="{{ 'products.product.gallery' | t }}" data-gallery>
        {%- for media in product.media -%}
          {%- liquid
            assign caption = captions[forloop.index0]
            assign n = forloop.index
            if n < 10
              assign n = forloop.index | prepend: '0'
            endif
            assign load = 'lazy'
            if forloop.first
              assign load = 'eager'
            endif
          -%}
          {%- liquid
            comment
              Desktop grid: first image full width, then pairs; a leftover last image spans the full row.
            endcomment
            assign rest = forloop.length | minus: 1 | modulo: 2
            assign wide = false
            if forloop.first or forloop.last and rest == 1
              assign wide = true
            endif
          -%}
          <li class="relative aspect-[4/5] w-[85%] shrink-0 snap-center overflow-hidden bg-asphalt lg:w-auto {% if wide %}lg:col-span-2{% endif %}" data-img-reveal data-gallery-item>
            {%- if media.media_type == 'image' -%}
              <button type="button" class="group absolute inset-0 block h-full w-full cursor-zoom-in" data-zoom="{{ media | image_url: width: 2400 }}" data-zoom-alt="{{ media.alt | default: product.title | escape }}" aria-label="{{ 'products.product.zoom' | t: n: n }}">
                {%- if forloop.first -%}
                  {{ media | image_url: width: 1600 | image_tag: widths: '540, 720, 1000, 1300, 1600', sizes: '(min-width: 1024px) 58vw, 85vw', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]', loading: load, fetchpriority: 'high', alt: media.alt | default: product.title }}
                {%- else -%}
                  {{ media | image_url: width: 1600 | image_tag: widths: '540, 720, 1000, 1300, 1600', sizes: '(min-width: 1024px) 29vw, 85vw', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]', loading: load, alt: media.alt | default: product.title }}
                {%- endif -%}
              </button>
            {%- else -%}
              {{ media | media_tag: image_size: '1600x', class: 'absolute inset-0 h-full w-full object-cover' }}
            {%- endif -%}
            {%- comment -%} Fig. caption: from custom.immagini_didascalie (one entry per media, same order), never inferred from the position. {%- endcomment -%}
            <p class="label pointer-events-none absolute bottom-3 left-3 z-[1] bg-obsidian/60 px-2 py-1 text-dirty">Fig. {{ n }}{% if caption != blank %} — {{ caption }}{% endif %}</p>
          </li>
        {%- else -%}
          <li class="relative aspect-[4/5] w-full bg-asphalt lg:col-span-2">{{ 'product-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full fill-concrete/30' }}</li>
        {%- endfor -%}
      </ul>
      {%- if product.media.size > 1 -%}
        <div class="mt-4 flex justify-center gap-2 lg:hidden" aria-hidden="true" data-gallery-dots>
          {%- for media in product.media -%}<span class="h-1 w-6 bg-dirty/25 transition-colors {% if forloop.first %}!bg-dirty{% endif %}"></span>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <p class="label text-signal">{% if mf.codice != blank %}{{ mf.codice }} · {% endif %}{{ product.type | default: product.vendor }}</p>
        <h1 class="font-display mt-3 text-[clamp(2.8rem,6vw,5.5rem)] leading-[0.9]">{{ product.title }}</h1>

        <div class="mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span class="text-2xl">{% render 'price', product: product %}</span>
          <span class="label text-concrete">{{ 'products.product.price_note' | t }}</span>
        </div>
        {%- if current.compare_at_price > current.price and mf.prezzo_minimo_30gg != blank -%}
          <p class="mt-2 text-sm text-dirty/75">{{ 'products.product.lowest_30_days' | t }}: <span class="font-mono">{{ mf.prezzo_minimo_30gg.value | money }}</span></p>
        {%- endif -%}
        {%- if upcoming -%}
          <p class="label mt-4 inline-block bg-signal px-3 py-1.5 text-obsidian">{{ 'products.product.release_date' | t: date: release | date: '%d/%m/%Y' }}</p>
        {%- endif -%}

        {%- form 'product', product, id: form_id, class: 'mt-8 space-y-6', data-product-form: '', data-main-form: '' -%}
          <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset>
                <legend class="label mb-3 flex w-full items-center justify-between text-concrete">
                  <span>{{ option.name }}: <span class="text-dirty" data-option-value="{{ forloop.index0 }}">{{ option.selected_value }}</span></span>
                  {%- if forloop.first -%}
                    <button type="button" class="label inline-flex min-h-11 items-center gap-2 text-dirty underline underline-offset-4 hover:text-signal" data-size-guide-open aria-haspopup="dialog">{{ 'products.product.size_guide' | t }}</button>
                  {%- endif -%}
                </legend>
                <div class="flex flex-wrap gap-2">
                  {%- assign oi = forloop.index0 -%}
                  {%- for value in option.values -%}
                    <label class="relative">
                      <input type="radio" class="peer sr-only" name="option-{{ oi }}" value="{{ value | escape }}" data-option-index="{{ oi }}" {% if option.selected_value == value %}checked{% endif %} {% if product.options.size == 1 and value.available == false %}disabled{% endif %}>
                      <span class="label flex min-h-12 min-w-14 cursor-pointer items-center justify-center border border-dirty/30 px-4 text-dirty transition-colors hover:border-dirty peer-checked:border-dirty peer-checked:bg-dirty peer-checked:text-obsidian peer-disabled:cursor-not-allowed peer-disabled:border-dirty/10 peer-disabled:text-concrete peer-disabled:line-through peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-signal">{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          {%- if buyable -%}
            <div class="flex gap-3" data-atc-row>
              <div class="flex items-center border border-dirty/30">
                <button type="button" class="flex size-12 items-center justify-center hover:text-signal" data-qty-step="-1" aria-label="{{ 'products.product.quantity_decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                <input type="number" name="quantity" value="1" min="1" class="w-10 bg-transparent text-center font-mono [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none" aria-label="{{ 'products.product.quantity' | t }}" data-qty-input>
                <button type="button" class="flex size-12 items-center justify-center hover:text-signal" data-qty-step="1" aria-label="{{ 'products.product.quantity_increase' | t }}">{% render 'icon', name: 'plus' %}</button>
              </div>
              <button type="submit" name="add" class="label flex min-h-12 flex-1 items-center justify-center gap-3 bg-blood px-6 text-dirty transition-colors hover:bg-dirty hover:text-obsidian disabled:cursor-not-allowed disabled:bg-concrete/40 disabled:text-dirty/60" data-add-button {% unless current.available %}disabled{% endunless %}>
                {%- if current.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
              </button>
            </div>
            <div class="payment-buttons" data-payment-buttons>{{ form | payment_button }}</div>
          {%- else -%}
            <button type="button" class="label flex min-h-12 w-full items-center justify-center bg-concrete/40 px-6 text-dirty/70" disabled data-add-button>
              {%- if pending -%}{{ 'products.product.coming_soon' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </button>
          {%- endif -%}

          <p class="label min-h-4 text-[0.65rem] text-concrete" data-availability aria-live="polite">
            {%- liquid
              if product.tags contains 'prezzo-da-confermare'
                echo 'products.product.price_pending_note' | t
              elsif upcoming
                echo 'products.product.upcoming_note' | t
              elsif pending
                echo 'products.product.sizes_pending_note' | t
              elsif current.available
                echo 'products.product.in_stock' | t
              else
                echo 'products.product.sold_out' | t
              endif
            -%}
          </p>
          <p class="hidden border-l-4 border-signal px-3 py-2 text-sm text-dirty" role="alert" data-form-error></p>

          {%- comment -%} Variant data for the picker. Low stock only from real, tracked inventory. {%- endcomment -%}
          <script type="application/json" data-variants>
            [{%- for v in product.variants -%}
              {%- liquid
                assign low = 0
                if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' and v.inventory_quantity > 0 and v.inventory_quantity <= 3
                  assign low = v.inventory_quantity
                endif
              -%}
              {"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }},"low":{{ low }}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}]
          </script>
        {%- endform -%}

        {%- comment -%} Back in stock / release reminder: customer form with a dedicated tag, separate explicit consent. {%- endcomment -%}
        {%- if buyable == false -%}
          <div class="mt-6 border border-dirty/15 bg-asphalt p-5">
            <p class="font-display text-2xl">{{ 'products.product.notify_title' | t }}</p>
            {%- form 'customer', id: 'notify-form', class: 'mt-3' -%}
              {%- if form.posted_successfully? -%}
                <p class="text-sm text-dirty" role="status">{{ 'products.product.notify_done' | t }}</p>
              {%- else -%}
                <input type="hidden" name="contact[tags]" value="avvisami, avvisami-{{ product.handle }}">
                <label for="notify-email" class="sr-only">{{ 'newsletter.label' | t }}</label>
                <div class="flex border-b border-dirty/40 focus-within:border-dirty">
                  <input id="notify-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" class="min-h-11 w-full bg-transparent font-mono text-sm text-dirty placeholder:text-concrete focus:outline-none">
                  <button type="submit" class="label min-h-11 px-2 text-dirty hover:text-signal">{{ 'products.product.notify_button' | t }}</button>
                </div>
                <div class="mt-3 flex items-start gap-3">
                  <input id="notify-consent" type="checkbox" name="contact[accepts_marketing]" value="true" required class="mt-0.5 size-5 shrink-0 accent-[#e5484d]">
                  <label for="notify-consent" class="text-xs leading-relaxed text-dirty/80">{{ 'products.product.notify_consent' | t }} <a href="{{ routes.root_url }}?view=privacy" class="underline underline-offset-2">{{ 'newsletter.privacy_link' | t }}</a>.</label>
                </div>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}

        {%- comment -%} Reassurance under the CTA (only true, verifiable statements). {%- endcomment -%}
        <ul class="mt-6 grid gap-3 border-y border-dirty/15 py-5 text-sm text-dirty/85">
          <li class="flex items-start gap-3">{% render 'icon', name: 'truck', class: 'mt-0.5 size-5 shrink-0 text-signal' %}
            <span>
              {%- if settings.free_shipping_threshold > 0 -%}
                {%- assign threshold = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros -%}
                {{ 'products.product.free_shipping' | t: amount: threshold }}
              {%- else -%}
                {{ 'products.product.shipping_info' | t }}
              {%- endif -%}
              {%- if settings.delivery_text != blank %} · {{ settings.delivery_text }}{% endif -%}
            </span>
          </li>
          <li class="flex items-start gap-3">{% render 'icon', name: 'return', class: 'mt-0.5 size-5 shrink-0 text-signal' %}
            <span>{{ 'products.product.returns_info' | t: days: settings.returns_days }} — <a href="{{ routes.root_url }}?view=recesso#doc-resi" class="underline underline-offset-2 hover:text-dirty">{{ 'products.product.read_more' | t }}</a></span>
          </li>
          <li class="flex items-start gap-3">{% render 'icon', name: 'lock', class: 'mt-0.5 size-5 shrink-0 text-signal' %}
            <span>{{ 'products.product.secure_payment' | t }}</span>
          </li>
        </ul>
        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="{{ 'sections.footer.payments' | t }}">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'h-6 w-auto' }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} Info tabs: each appears only when its data exists (no invented specs). {%- endcomment -%}
        <div class="mt-8 divide-y divide-dirty/15 border-b border-dirty/15">
          <details class="group py-5" open>
            <summary class="label flex min-h-11 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">{{ 'products.product.details' | t }} <span class="transition-transform group-open:rotate-45">{% render 'icon', name: 'plus' %}</span></summary>
            <div class="prose-22 mt-4 text-base leading-relaxed text-dirty/85">{{ product.description }}</div>
          </details>

          {%- if mf.composizione != blank or mf.grammatura_gm2 != blank or mf.tecnica_stampa != blank or mf.paese_produzione != blank or mf.cura_lavaggio != blank -%}
            <details class="group py-5">
              <summary class="label flex min-h-11 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">{{ 'products.product.tab_composition' | t }} <span class="transition-transform group-open:rotate-45">{% render 'icon', name: 'plus' %}</span></summary>
              <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-base text-dirty/85">
                {%- if mf.composizione != blank -%}<dt class="label pt-1 text-concrete">{{ 'products.product.composition' | t }}</dt><dd>{{ mf.composizione | newline_to_br }}</dd>{%- endif -%}
                {%- if mf.grammatura_gm2 != blank -%}<dt class="label pt-1 text-concrete">{{ 'products.product.weight' | t }}</dt><dd>{{ mf.grammatura_gm2 }} g/m²</dd>{%- endif -%}
                {%- if mf.tecnica_stampa != blank -%}<dt class="label pt-1 text-concrete">{{ 'products.product.print' | t }}</dt><dd>{{ mf.tecnica_stampa }}</dd>{%- endif -%}
                {%- if mf.paese_produzione != blank -%}<dt class="label pt-1 text-concrete">{{ 'products.product.made_in' | t }}</dt><dd>{{ mf.paese_produzione }}</dd>{%- endif -%}
                {%- if mf.cura_lavaggio != blank -%}<dt class="label pt-1 text-concrete">{{ 'products.product.care' | t }}</dt><dd>{{ mf.cura_lavaggio | newline_to_br }}</dd>{%- endif -%}
              </dl>
            </details>
          {%- endif -%}

          {%- if mf.fit != blank or mf.consiglio_taglia != blank or mf.modello_altezza_cm != blank -%}
            <details class="group py-5">
              <summary class="label flex min-h-11 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">{{ 'products.product.tab_fit' | t }} <span class="transition-transform group-open:rotate-45">{% render 'icon', name: 'plus' %}</span></summary>
              <div class="mt-4 space-y-2 text-base text-dirty/85">
                {%- if mf.fit != blank -%}<p><span class="label text-concrete">{{ 'products.product.fit' | t }}:</span> {{ mf.fit }}</p>{%- endif -%}
                {%- if mf.consiglio_taglia != blank -%}<p>{{ mf.consiglio_taglia }}</p>{%- endif -%}
                {%- if mf.modello_altezza_cm != blank and mf.modello_taglia != blank -%}<p>{{ 'products.product.model' | t: height: mf.modello_altezza_cm, size: mf.modello_taglia }}</p>{%- endif -%}
              </div>
            </details>
          {%- endif -%}

          <details class="group py-5">
            <summary class="label flex min-h-11 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">{{ 'products.product.tab_shipping' | t }} <span class="transition-transform group-open:rotate-45">{% render 'icon', name: 'plus' %}</span></summary>
            <div class="mt-4 space-y-3 text-base leading-relaxed text-dirty/85">
              <p>{{ 'products.product.shipping_summary' | t }}</p>
              <p>{{ 'products.product.returns_summary' | t: days: settings.returns_days }}</p>
              <p class="flex flex-wrap gap-x-4 gap-y-1">
                <a href="{{ routes.root_url }}?view=spedizioni" class="underline underline-offset-2 hover:text-dirty">{{ 'sections.legal.docs.spedizioni' | t }}</a>
                <a href="{{ routes.root_url }}?view=recesso" class="underline underline-offset-2 hover:text-dirty">{{ 'sections.legal.docs.resi' | t }}</a>
                <a href="{{ routes.root_url }}?view=garanzia" class="underline underline-offset-2 hover:text-dirty">{{ 'sections.legal.docs.garanzia' | t }}</a>
              </p>
            </div>
          </details>

          {%- assign maker = mf.fabbricante.value -%}
          {%- if maker != blank -%}
            <details class="group py-5">
              <summary class="label flex min-h-11 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">{{ 'products.product.tab_safety' | t }} <span class="transition-transform group-open:rotate-45">{% render 'icon', name: 'plus' %}</span></summary>
              <div class="mt-4 space-y-1 text-base text-dirty/85">
                <p class="label text-concrete">{{ 'products.product.manufacturer' | t }}</p>
                {%- if maker.nome != blank -%}<p>{{ maker.nome }}</p>{%- endif -%}
                {%- if maker.indirizzo != blank -%}<p>{{ maker.indirizzo | newline_to_br }}</p>{%- endif -%}
                {%- if maker.contatto != blank -%}<p>{{ maker.contatto }}</p>{%- endif -%}
                {%- if mf.codice != blank -%}<p class="pt-2"><span class="label text-concrete">{{ 'products.product.product_id' | t }}:</span> {{ mf.codice }}</p>{%- endif -%}
              </div>
            </details>
          {%- endif -%}

          {%- for block in section.blocks -%}
            <details class="group py-5" {{ block.shopify_attributes }}>
              <summary class="label flex min-h-11 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">{{ block.settings.heading }} <span class="transition-transform group-open:rotate-45">{% render 'icon', name: 'plus' %}</span></summary>
              <div class="mt-4 text-base leading-relaxed text-dirty/85">{{ block.settings.content }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%}
  Complete the look: custom.abbinamenti if set, otherwise pieces from the complementary line
  (tops ↔ bottoms). Only available products with a confirmed price.
{%- endcomment -%}
{%- liquid
  assign look = mf.abbinamenti.value
  if look == blank or look.size == 0
    assign other = blank
    if product.tags contains 'linea-pantaloni'
      assign other = 't-shirt'
    elsif product.tags contains 'linea-t-shirt' or product.tags contains 'linea-longsleeve'
      assign other = 'pantaloni'
    endif
    if other != blank
      assign look = collections[other].products
    endif
  endif
  assign look_count = 0
-%}
{%- capture look_items -%}
  {%- for p in look -%}
    {%- if look_count >= 3 -%}{%- break -%}{%- endif -%}
    {%- if p.id != product.id and p.available -%}
      {%- unless p.tags contains 'prezzo-da-confermare' or p.tags contains 'taglie-da-confermare' -%}
        {%- assign look_count = look_count | plus: 1 -%}
        <li>{%- render 'product-card', product: p -%}</li>
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if look_count > 0 -%}
  <section class="px-gutter pb-16" aria-labelledby="look-{{ section.id }}">
    <h2 id="look-{{ section.id }}" class="font-display text-big">{{ section.settings.look_title }}</h2>
    <ul class="mt-8 grid grid-cols-2 gap-x-3 gap-y-10 md:gap-x-5 lg:grid-cols-3">{{ look_items }}</ul>
  </section>
{%- endif -%}

{%- comment -%} Size guide (dialog: Esc, focus trap and focus return are native). {%- endcomment -%}
<dialog class="m-auto w-[min(92vw,44rem)] max-h-[88vh] overflow-y-auto border border-dirty/20 bg-asphalt p-0 text-dirty backdrop:bg-obsidian/80" aria-labelledby="size-guide-title-{{ section.id }}" data-size-guide>
  <div class="sticky top-0 flex items-center justify-between border-b border-dirty/15 bg-asphalt px-6 py-4">
    <h2 id="size-guide-title-{{ section.id }}" class="font-display text-3xl">{{ 'products.product.size_guide' | t }}</h2>
    <button type="button" class="label flex min-h-11 items-center gap-2 px-2 hover:text-signal" data-size-guide-close>{{ 'sections.cart.close' | t }} {% render 'icon', name: 'x' %}</button>
  </div>
  <div class="space-y-6 px-6 py-6 text-base leading-relaxed text-dirty/85">
    {%- assign chart = mf.tabella_misure.value.misure.value -%}
    {%- if chart.colonne and chart.righe -%}
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="label mb-3 text-left text-concrete">{{ 'products.product.measures_cm' | t }}</caption>
          <thead><tr>{%- for c in chart.colonne -%}<th scope="col" class="border border-dirty/20 px-3 py-2 font-semibold text-dirty">{{ c }}</th>{%- endfor -%}</tr></thead>
          <tbody>
            {%- for r in chart.righe -%}
              <tr>{%- for cell in r -%}{%- if forloop.first -%}<th scope="row" class="border border-dirty/20 px-3 py-2 font-semibold text-dirty">{{ cell }}</th>{%- else -%}<td class="border border-dirty/20 px-3 py-2 font-mono">{{ cell }}</td>{%- endif -%}{%- endfor -%}</tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
    {%- if mf.modello_altezza_cm != blank and mf.modello_taglia != blank -%}
      <p>{{ 'products.product.model' | t: height: mf.modello_altezza_cm, size: mf.modello_taglia }}</p>
    {%- endif -%}
    {%- if mf.consiglio_taglia != blank -%}<p>{{ mf.consiglio_taglia }}</p>{%- endif -%}
    <div>
      <p class="label mb-2 text-concrete">{{ 'products.product.how_to_measure' | t }}</p>
      <ul class="list-disc space-y-1 pl-5">
        <li>{{ 'products.product.measure_chest' | t }}</li>
        <li>{{ 'products.product.measure_length' | t }}</li>
        <li>{{ 'products.product.measure_waist' | t }}</li>
      </ul>
      <p class="mt-3">{{ 'products.product.measure_tip' | t }}</p>
    </div>
    <p>{{ 'products.product.size_help' | t }} <a href="{{ routes.root_url }}pages/contact" class="underline underline-offset-2">{{ 'products.product.size_help_link' | t }}</a>.</p>
  </div>
</dialog>

{%- comment -%} Zoom {%- endcomment -%}
<dialog class="m-0 h-full max-h-none w-full max-w-none bg-obsidian/95 p-0 backdrop:bg-obsidian" aria-label="{{ 'products.product.gallery' | t }}" data-lightbox>
  <button type="button" class="label fixed right-4 top-4 z-10 flex min-h-11 items-center gap-2 bg-obsidian/70 px-3 text-dirty hover:text-signal" data-lightbox-close>{{ 'sections.cart.close' | t }} {% render 'icon', name: 'x' %}</button>
  <div class="flex h-full w-full items-center justify-center overflow-auto p-4"><img alt="" width="1600" height="2000" class="h-auto max-h-none w-auto max-w-[min(100%,1400px)]" data-lightbox-img></div>
</dialog>

{%- comment -%} Sticky add-to-cart on mobile, shown when the main button scrolls out of view. {%- endcomment -%}
{%- if buyable -%}
  <div class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-dirty/15 bg-obsidian/95 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur-md transition-transform duration-300 lg:hidden" data-sticky-atc aria-hidden="true">
    <div class="flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-semibold">{{ product.title }}</p>
        <p class="label text-concrete"><span data-sticky-size>{{ current.title }}</span> · <span data-sticky-price>{{ current.price | money }}</span></p>
      </div>
      <button type="submit" form="{{ form_id }}" class="label min-h-12 shrink-0 bg-blood px-5 text-dirty disabled:bg-concrete/40" tabindex="-1" data-sticky-add {% unless current.available %}disabled{% endunless %}>{{ 'products.product.add_to_cart' | t }}</button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Prodotto",
  "settings": [
    { "type": "text", "id": "look_title", "label": "Titolo abbinamenti", "default": "Complete the look." }
  ],
  "blocks": [
    { "type": "accordion", "name": "Riquadro informazioni", "settings": [
      { "type": "text", "id": "heading", "label": "Titolo", "default": "Informazioni" },
      { "type": "richtext", "id": "content", "label": "Contenuto" }
    ] }
  ]
}
{% endschema %}
