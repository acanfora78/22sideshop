<footer class="relative border-t border-dirty/10 bg-obsidian text-dirty">
  <div class="px-gutter grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <div class="relative flex max-w-md -rotate-1 overflow-hidden bg-dirty text-obsidian">
        <div class="flex-1 p-5 md:p-6">
          <div class="label flex items-center justify-between text-obsidian/70"><span>Line 22 — Admit one</span><span>No. 002222</span></div>
          <p class="font-display mt-3 text-4xl md:text-5xl">{{ section.settings.newsletter_title }}</p>
          <p class="mt-3 text-sm leading-relaxed text-obsidian/75">{{ section.settings.newsletter_text }}</p>
        </div>
        <div aria-hidden="true" class="relative flex w-16 flex-col items-center justify-center gap-3 border-l-2 border-dashed border-obsidian/40 md:w-20">
          {%- render 'line-bullet', size: 'md' -%}
          <span class="label [writing-mode:vertical-rl]">22 Side St.</span>
        </div>
      </div>

      {%- form 'customer', id: 'footer-newsletter', class: 'mt-8 max-w-md' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="newsletter-email" class="sr-only">{{ 'newsletter.label' | t }}</label>
        <div class="flex border-b border-dirty/40 focus-within:border-dirty">
          <input id="newsletter-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" class="w-full bg-transparent py-3 font-mono text-sm text-dirty placeholder:text-concrete focus:outline-none">
          <button type="submit" class="label flex items-center gap-2 px-2 text-dirty hover:text-blood-bright">{{ 'newsletter.button' | t }} {% render 'icon', name: 'arrow-right' %}</button>
        </div>
        <p class="label mt-3 min-h-4 text-[0.6rem] text-concrete" role="status">
          {%- if form.posted_successfully? -%}<span class="text-dirty">{{ 'newsletter.success' | t }}</span>
          {%- elsif form.errors -%}<span class="text-blood-bright">{{ form.errors | default_errors }}</span>
          {%- else -%}{{ 'newsletter.note' | t }}{%- endif -%}
        </p>
      {%- endform -%}
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-6 md:col-start-7">
      {%- for i in (1..3) -%}
        {%- liquid
          assign key = 'menu_' | append: i
          assign m = linklists[section.settings[key]]
        -%}
        {%- if m.links.size > 0 -%}
          <div>
            <p class="label mb-4 text-concrete">{{ m.title }}</p>
            <ul class="space-y-2.5 text-sm">
              {%- for link in m.links -%}<li><a href="{{ link.url }}" class="link-underline text-dirty/80 hover:text-dirty">{{ link.title }}</a></li>{%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
      <div>
        <p class="label mb-4 text-concrete">22SIDE</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="{{ routes.collections_url }}" class="link-underline text-dirty/80 hover:text-dirty">{{ 'sections.header.collections' | t }}</a></li>
          {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" class="link-underline text-dirty/80 hover:text-dirty">Instagram ↗</a></li>{%- endif -%}
        </ul>
      </div>
    </div>
  </div>

  <div class="px-gutter border-t border-dirty/10 py-10">
    <p class="label mb-6 text-concrete">Line 22 — {{ 'sections.footer.map' | t }}</p>
    <div class="no-scrollbar overflow-x-auto">
      <ol class="relative flex min-w-[560px] items-start justify-between">
        <span aria-hidden="true" class="absolute left-2 right-2 top-[7px] h-[3px] bg-blood"></span>
        {%- assign stops = '22 Side Street,The Whole Block,Collections,The Counter' | split: ',' -%}
        {%- assign urls = routes.root_url | append: ',' | append: routes.all_products_collection_url | append: ',' | append: routes.collections_url | append: ',' | append: routes.cart_url | split: ',' -%}
        {%- for s in stops -%}
          <li class="relative"><a href="{{ urls[forloop.index0] }}" class="flex flex-col items-center gap-2 text-center"><span class="block size-[17px] rounded-full border-[3px] border-blood {% if forloop.first or forloop.last %}bg-blood{% else %}bg-obsidian{% endif %}"></span><span class="label max-w-[6rem] text-[0.6rem] text-dirty/70">{{ s }}</span></a></li>
        {%- endfor -%}
      </ol>
    </div>
    {%- if section.settings.support_text != blank -%}<p class="mt-8 text-sm text-dirty/70">{{ section.settings.support_text }}</p>{%- endif -%}
  </div>

  <div class="px-gutter label flex flex-col gap-3 border-t border-dirty/10 pb-10 pt-6 text-concrete md:flex-row md:items-center md:justify-between">
    <div class="flex flex-wrap items-center gap-4">
      {%- render 'logo', class: 'text-xl text-dirty' -%}
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} — Independent Streetwear</span>
      <button type="button" class="link-underline text-dirty hover:text-blood-bright" data-replay-intro>{{ 'sections.footer.replay_intro' | t }}</button>
    </div>
    <div class="flex items-center gap-3">{{ powered_by_link }}</div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "newsletter_title", "label": "Titolo newsletter", "default": "Get on the list" },
    { "type": "textarea", "id": "newsletter_text", "label": "Testo newsletter", "default": "La Side Letter: nuovi drop, restock e storie dalla Line 22, prima di tutti." },
    { "type": "link_list", "id": "menu_1", "label": "Menu colonna 1", "default": "footer" },
    { "type": "link_list", "id": "menu_2", "label": "Menu colonna 2" },
    { "type": "link_list", "id": "menu_3", "label": "Menu colonna 3" },
    { "type": "text", "id": "support_text", "label": "Testo assistenza", "default": "Hai bisogno di aiuto? Scrivici su Instagram @22sideshop." }
  ]
}
{% endschema %}
