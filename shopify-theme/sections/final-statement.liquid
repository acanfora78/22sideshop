<section id="last-stop" class="relative isolate overflow-hidden pt-32 md:pt-48" aria-label="Last Stop">
  <div class="absolute inset-0 -z-10">
    <img src="{{ 'scene-chainlink.jpg' | asset_url }}" alt="" loading="lazy" class="h-full w-full object-cover opacity-20" width="2000" height="1300">
    <div class="absolute inset-0 bg-gradient-to-b from-obsidian via-obsidian/60 to-obsidian"></div>
  </div>
  <div class="px-gutter">
    <p class="label text-concrete"><span class="text-signal">{{ section.settings.index }}</span> / {{ section.settings.label }}</p>
    <h2 class="mt-12 md:mt-20">
      <span class="font-display text-big block text-dirty/90" data-split>{{ section.settings.line_one }}</span>
      <span class="font-display text-huge mt-2 block text-signal" data-split>{{ section.settings.line_two }}</span>
    </h2>
    <div class="label mt-12 flex flex-wrap justify-between gap-4 text-concrete">
      <span>{{ settings.slogan }}</span>
      {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" class="link-underline text-dirty">{{ section.settings.follow }} ↗</a>{%- endif -%}
    </div>
  </div>
  <div class="mt-16 flex justify-center overflow-hidden whitespace-nowrap pb-2 md:mt-24" aria-hidden="true" data-final-logo>
    {%- render 'logo', class: 'text-[26.5vw] leading-[0.78]' -%}
  </div>
</section>

{% schema %}
{
  "name": "Chiusura",
  "settings": [
    { "type": "text", "id": "index", "label": "Numero", "default": "05" },
    { "type": "text", "id": "label", "label": "Etichetta", "default": "Last Stop" },
    { "type": "text", "id": "line_one", "label": "Riga 1", "default": "You don't follow the side." },
    { "type": "text", "id": "line_two", "label": "Riga 2", "default": "You create it." },
    { "type": "text", "id": "follow", "label": "Link Instagram", "default": "Seguici su Instagram @22sideshop" }
  ],
  "presets": [{ "name": "Chiusura" }]
}
{% endschema %}
