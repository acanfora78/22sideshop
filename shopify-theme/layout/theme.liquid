<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="antialiased">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#080808">
    {%- liquid
      assign legal_view = false
      if template.name == 'index' and template.suffix != blank
        assign legal_view = true
        assign legal_key = 'sections.legal.docs.' | append: template.suffix
        assign legal_title = legal_key | t
      endif
    -%}
    {%- if legal_view -%}
      <link rel="canonical" href="{{ shop.url }}{{ routes.root_url }}?view={{ template.suffix }}">
    {%- else -%}
      <link rel="canonical" href="{{ canonical_url }}">
    {%- endif -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {% if legal_view %}{{ legal_title }} &ndash; {% endif %}{{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wdth,wght@62..125,100..900&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Permanent+Marker&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {%- comment -%} Before first paint: hide the intro for visitors who already saw it in this session. {%- endcomment -%}
    <script>
      try { if (sessionStorage.getItem('22side.intro.seen')) document.documentElement.setAttribute('data-intro', 'seen'); } catch (e) {}
      window.theme = {
        routes: { cart_add_url: '{{ routes.cart_add_url }}', cart_change_url: '{{ routes.cart_change_url }}', cart_url: '{{ routes.cart_url }}', root_url: '{{ routes.root_url }}' },
        strings: { added: {{ 'products.product.added' | t | json }}, addToCart: {{ 'products.product.add_to_cart' | t | json }}, soldOut: {{ 'products.product.sold_out' | t | json }}, unavailable: {{ 'products.product.unavailable' | t | json }}, selectSize: {{ 'products.product.select_size' | t | json }} }
      };
    </script>

    <noscript><style>[data-intro-overlay]{display:none}[data-reveal]{opacity:1;transform:none}[data-img-reveal]::after{display:none}</style></noscript>

    {{ content_for_header }}
  </head>

  <body class="min-h-dvh bg-obsidian text-dirty template-{{ template.name }}">
    <a href="#main" class="label sr-only z-[100] bg-dirty px-4 py-3 text-obsidian focus:not-sr-only focus:fixed focus:left-3 focus:top-3">{{ 'accessibility.skip_to_content' | t }}</a>

    {% section 'header' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% section 'cart-drawer' %}

    <div class="grain" aria-hidden="true"></div>

    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
